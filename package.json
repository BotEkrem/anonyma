{
  "name": "anonyma",
  "version": "0.1.0",
  "private": true,
  "description": "Anonyma — ephemeral anonymous text/voice/video chat",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build && pnpm -r --filter=./apps/* build",
    "build:shared": "pnpm --filter @anonyma/shared build",
    "dev:gateway": "pnpm --filter @anonyma/gateway start:dev",
    "dev:core": "pnpm --filter @anonyma/core start:dev",
    "dev:match": "pnpm --filter @anonyma/match start:dev",
    "dev:web": "pnpm --filter @anonyma/web dev",
    "dev:realtime": "cargo run --manifest-path apps/realtime/Cargo.toml",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "typecheck": "pnpm -r --filter=./packages/* --filter=./apps/gateway --filter=./apps/core --filter=./apps/match --filter=./apps/web typecheck",
    "build:packages": "pnpm --filter @anonyma/shared build && pnpm --filter @anonyma/nest-common build",
    "test": "pnpm -r --filter=./apps/gateway --filter=./apps/core --filter=./apps/match --filter=./apps/web test && cargo test --release --manifest-path apps/realtime/Cargo.toml",
    "check": "pnpm build:packages && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.13.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=20"
  }
}
