{
  "name": "@anonyma/core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:baseline": "tsx src/db/baseline.ts"
  },
  "dependencies": {
    "@anonyma/nest-common": "workspace:*",
    "@anonyma/shared": "workspace:*",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/microservices": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.5",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^5.6.0",
    "mongodb": "^6.14.2",
    "pg": "^8.14.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@types/amqplib": "^0.10.7",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
