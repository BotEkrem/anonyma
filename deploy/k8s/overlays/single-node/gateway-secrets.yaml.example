# Generated on the server by bootstrap.sh — gateway-only secrets (LiveKit / Turnstile).
apiVersion: v1
kind: Secret
metadata:
  name: anonyma-gateway-secrets
  namespace: anonyma
type: Opaque
stringData:
  IDENTITY_PEPPER: change-me
  TURNSTILE_SITE_KEY: change-me
  TURNSTILE_SECRET_KEY: change-me
  LIVEKIT_URL: wss://rtc.example.com
  LIVEKIT_API_KEY: change-me
  LIVEKIT_API_SECRET: change-me
