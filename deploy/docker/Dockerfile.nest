# syntax=docker/dockerfile:1
# Every workspace manifest and the lockfile: installs are --frozen-lockfile, so
# the image gets exactly the versions in pnpm-lock.yaml.
FROM node:22-alpine AS base
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared/package.json packages/shared/
COPY packages/nest-common/package.json packages/nest-common/
COPY apps/gateway/package.json apps/gateway/
COPY apps/core/package.json apps/core/
COPY apps/match/package.json apps/match/
COPY apps/web/package.json apps/web/

FROM base AS build
ARG APP
RUN pnpm install --frozen-lockfile --filter "@anonyma/${APP}..."
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY packages/nest-common packages/nest-common
COPY apps/${APP} apps/${APP}
RUN pnpm --filter @anonyma/shared build \
  && pnpm --filter @anonyma/nest-common build \
  && pnpm --filter "@anonyma/${APP}" build \
  && mkdir -p /out/packages/shared /out/packages/nest-common "/out/apps/${APP}" \
  && cp -r packages/shared/package.json packages/shared/dist /out/packages/shared/ \
  && cp -r packages/nest-common/package.json packages/nest-common/dist /out/packages/nest-common/ \
  && cp -r "apps/${APP}/package.json" "apps/${APP}/dist" "/out/apps/${APP}/" \
  && if [ -d "apps/${APP}/drizzle" ]; then cp -r "apps/${APP}/drizzle" "/out/apps/${APP}/"; fi

# Runtime dependencies only (no compilers, test tools or type packages).
FROM base AS prod-deps
ARG APP
RUN pnpm install --frozen-lockfile --prod --filter "@anonyma/${APP}..."

FROM node:22-alpine AS runner
WORKDIR /app
ARG APP
ENV NODE_ENV=production
COPY --from=prod-deps /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=prod-deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=prod-deps /app/packages/nest-common/node_modules ./packages/nest-common/node_modules
COPY --from=prod-deps /app/apps/${APP}/node_modules ./apps/${APP}/node_modules
COPY --from=build /out/ ./
WORKDIR /app/apps/${APP}
# The image's own "node" user, by number so Kubernetes can check runAsNonRoot.
USER 1000:1000
EXPOSE 3000
CMD ["node", "dist/main.js"]
