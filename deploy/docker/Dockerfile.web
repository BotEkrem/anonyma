# syntax=docker/dockerfile:1
FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
# Every workspace manifest and the lockfile, so the install is --frozen-lockfile.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared/package.json packages/shared/
COPY packages/nest-common/package.json packages/nest-common/
COPY apps/gateway/package.json apps/gateway/
COPY apps/core/package.json apps/core/
COPY apps/match/package.json apps/match/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --filter "@anonyma/web..."
# The page compiles packages/shared/src/contracts.ts (and what it reaches) from source.
COPY packages/shared/src packages/shared/src
COPY apps/web apps/web
RUN pnpm --filter @anonyma/web build

# Runs as uid 101 and listens on 8080 (no root needed for a low port).
FROM nginxinc/nginx-unprivileged:1.27-alpine
# Rendered into /etc/nginx/conf.d when the container starts. Only CSP_* variables
# are substituted, so nginx's own $variables are left alone.
ENV NGINX_ENVSUBST_FILTER=^CSP_ \
    CSP_CONNECT_EXTRA=wss:
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/docker/nginx.web.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
